# Copy to .env.local and fill in to enable TURN (needed for players behind
# carrier-grade NAT / strict firewalls). See design/networking.md.

# Option A: static TURN credentials
# VITE_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# VITE_TURN_USERNAME=user
# VITE_TURN_CREDENTIAL=secret

# Option B: endpoint returning a JSON array of RTCIceServer objects (or {iceServers: [...]})
# e.g. a Cloudflare Worker minting Realtime TURN credentials, or
# https://<app>.metered.live/api/v1/turn/credentials?apiKey=<key>
# VITE_ICE_SERVERS_URL=https://example.workers.dev/ice
