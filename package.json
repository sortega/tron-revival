{
  "name": "teratron",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "sprites": "npx tsx scripts/build-sprites.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "SIM_REPORT=1 vitest run tests/bots.test.ts --silent=false",
    "bots:trace": "BOT_TRACE=1 vitest run tests/bot-trace.test.ts --silent=false",
    "sim:human": "HUMAN_REPORT=${HUMAN_REPORT:-1} vitest run tests/human-report.test.ts --silent=false",
    "test:e2e": "node tests/e2e/touch.e2e.mjs && node tests/e2e/network.e2e.mjs",
    "test:e2e:touch": "node tests/e2e/touch.e2e.mjs",
    "test:e2e:bots": "node tests/e2e/bots.e2e.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.14.0",
    "free-tex-packer-core": "^0.3.9",
    "gh-pages": "^6.3.0",
    "node-turn": "^0.0.6",
    "playwright-core": "^1.65.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "nipplejs": "^0.10.2",
    "qrcode-generator": "^2.0.4",
    "trystero": "^0.27.0",
    "unique-names-generator": "^4.7.1"
  }
}
