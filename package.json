    "node-turn": "^0.0.6",
    "playwright-core": "^1.65.0",
    "pngjs": "^7.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "nipplejs": "^0.10.2",
    "qrcode-generator": "^2.0.4",
    "trystero": "^0.27.0",
    "unique-names-generator": "^4.7.1"
